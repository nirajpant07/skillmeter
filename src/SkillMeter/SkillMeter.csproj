<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>skillmeter</AssemblyName>
    <RootNamespace>SkillMeter</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NativeAOT: single self-contained binary, no .NET runtime required on the
         user's machine. Keeps the tool in the "survives neglect" archetype. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Fail the build if anything we reference is not trim/AOT safe. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- dotnet tool packaging. ToolPackageRuntimeIdentifiers makes `dotnet pack`
         emit a RID-agnostic pointer package plus per-RID packages; the CLI picks
         the right one transparently. Requires .NET SDK 10+. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skillmeter</ToolCommandName>
    <PackageId>skillmeter</PackageId>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>

  <!-- Single-sources the version into the binary.

       Program.Version used to be a hand-maintained const, so `dotnet publish
       -p:Version=x` changed the assembly metadata while the binary carried on
       reporting the old number: both from the version flag and from the
       `toolVersion` field, which is part of the documented JSON contract. A
       release would have shipped binaries that misreport themselves.

       Generated rather than read back through reflection, because looking up
       AssemblyInformationalVersionAttribute is exactly the reflection NativeAOT
       disallows, and a compile-time const costs nothing at runtime. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(BuildInfoFile)"
      Lines="// &lt;auto-generated /&gt; Generated from MSBuild %24(Version)%3B see GenerateBuildInfo.;namespace SkillMeter%3B;internal static class BuildInfo;{;    public const string Version = &quot;$(Version)&quot;%3B;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- RealPath is the most intricate function in the codebase and was previously
         reachable from tests only indirectly, through a full scan. -->
    <InternalsVisibleTo Include="SkillMeter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both first-party Microsoft. The Data package embeds the o200k_base
         vocabulary, so token counting is fully offline: no API key, no network. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />

    <!-- Transitive pin. Microsoft.ML.Tokenizers 2.0.0 resolves Microsoft.Bcl.Memory
         9.0.4, which carries a known high-severity advisory (GHSA-73j8-2gch-69rq).
         Pinning forward to the patched 10.x line. Remove once the tokenizer package
         updates its own floor. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
